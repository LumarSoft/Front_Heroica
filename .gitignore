# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Seguridad (16/11/2026): que no se suban claves, volcados ni archivos subidos
# variables de entorno: ".env*" (arriba) ya ignora .env, .env.local, .env.production, etc.; esta negación deja subir solo el ejemplo
!.env.example
# volcados de base de datos (este repo no versiona .sql; si algún día hace falta uno a propósito, se agrega con git add -f o una negación)
/*.sql
*dump*.sql
*backup*.sql
*.sql.gz
*.dump
# llaves y certificados (*.pem ya estaba arriba)
*.key
*.p12
*.pfx
# logs de cualquier herramienta (arriba solo estaban los de npm, yarn y pnpm)
*.log
